# Sample unit from svaram.live. Install to /etc/systemd/system/; settings in /etc/svaram/*.env.
[Unit]
Description=SVARAM translation, English to Telugu, in memory (127.0.0.1:8201)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=svaram-translate
Group=svaram-translate
WorkingDirectory=/opt/svaram/src/translate
Environment=SVARAM_SRC=/opt/svaram/src
EnvironmentFile=/etc/svaram/translate.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=2
Environment=HOME=/run/svaram-translate
Environment=XDG_CACHE_HOME=/run/svaram-translate/cache
Environment=HF_HOME=/run/svaram-translate/hf
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=TOKENIZERS_PARALLELISM=false
RuntimeDirectory=svaram-translate
RuntimeDirectoryMode=0700
ExecStart=/opt/svaram/translate/venv/bin/uvicorn svaram_translate:app --app-dir /opt/svaram/src/translate --host 127.0.0.1 --port 8201 --workers 1 --no-access-log --log-level warning --no-server-header
Restart=on-failure
RestartSec=5
TimeoutStartSec=180

CPUQuota=200%
MemoryMax=2048M
MemorySwapMax=0
LimitCORE=0
TasksMax=64

StandardOutput=null
StandardError=journal
PrivateTmp=yes
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/svaram
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
