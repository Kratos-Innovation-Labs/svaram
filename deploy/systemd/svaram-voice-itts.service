# Sample unit from svaram.live. Install to /etc/systemd/system/; settings in /etc/svaram/*.env.
[Unit]
Description=SVARAM Gujarati and Odia voice, in memory (127.0.0.1:8203)
# IIT Madras Indic TTS database) through Coqui TTS 0.28 (MPL-2.0) on PyTorch 2.7.1 (BSD), CPU.
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=svaram-voice-itts
Group=svaram-voice-itts
WorkingDirectory=/opt/svaram/src/voices/indictts
Environment=SVARAM_SRC=/opt/svaram/src
EnvironmentFile=/etc/svaram/voice-itts.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=2
Environment=HOME=/run/svaram-voice-itts
Environment=XDG_CACHE_HOME=/run/svaram-voice-itts/cache
Environment=NUMBA_CACHE_DIR=/run/svaram-voice-itts/numba
Environment=MPLCONFIGDIR=/run/svaram-voice-itts/mpl
Environment=TORCH_HOME=/run/svaram-voice-itts/torch
Environment=TOKENIZERS_PARALLELISM=false
RuntimeDirectory=svaram-voice-itts
RuntimeDirectoryMode=0700
ExecStart=/opt/svaram/voice-itts/venv/bin/uvicorn svaram_voice_itts:app --app-dir /opt/svaram/src/voices/indictts --host 127.0.0.1 --port 8203 --workers 1 --no-access-log --log-level warning --no-server-header
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

CPUQuota=200%
MemoryMax=3584M
MemorySwapMax=0
LimitCORE=0
TasksMax=64

StandardOutput=null
StandardError=journal
PrivateTmp=yes
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/svaram
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
