# Sample unit from svaram.live. Install to /etc/systemd/system/; settings in /etc/svaram/*.env.
[Unit]
Description=SVARAM voice process (in-memory speech, 127.0.0.1:8199)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=svaram-voice
Group=svaram-voice
WorkingDirectory=/opt/svaram/src/voices/rasa
Environment=SVARAM_SRC=/opt/svaram/src
EnvironmentFile=/etc/svaram/voice.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=2
ExecStart=/opt/svaram/voice/venv/bin/uvicorn svaram_voice:app --app-dir /opt/svaram/src/voices/rasa --host 127.0.0.1 --port 8199 --workers 1 --no-access-log --log-level warning
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

# ---- resource limits (Phase 0 starting values; tuned from P0-08) ----
CPUQuota=200%
MemoryMax=2G
MemorySwapMax=0
LimitCORE=0
TasksMax=64

# ---- privacy: nothing to disk, nothing to stdout ----
StandardOutput=null
StandardError=journal
PrivateTmp=yes
UMask=0077

# ---- isolation ----
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/svaram
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
