# /etc/svaram/api.env: svaram-api settings. Every value has a default; set only what you change.
# SVARAM_API_MAX_TEXT=500                     # longest message, in characters
# SVARAM_API_DEFAULT_LANG=te
# SVARAM_API_VOICE_URL=http://127.0.0.1:8199          # rasa voice service
# SVARAM_API_VOICE_HI_URL=http://127.0.0.1:8202       # kokoro voice service
# SVARAM_API_VOICE_ITTS_URL=http://127.0.0.1:8203     # indictts voice service
# SVARAM_API_TRANSLATE_URL=http://127.0.0.1:8201
# SVARAM_API_VOICE_TA=18:4                    # override a pack's voice (any language code)
# SVARAM_API_TA_FIRST_MAX=52                  # override a pack's first-segment size
