# /etc/svaram/voice-hi.env: the kokoro voice service (Hindi).
SVARAM_VOICE_HI_MODEL_DIR=/opt/svaram/voice-hi/model
SVARAM_VOICE_HI_MODEL=kokoro-v1.0.onnx
SVARAM_VOICE_HI_MODEL_SHA256=<sha256 of kokoro-v1.0.onnx, written by the installer>
SVARAM_VOICE_HI_VOICES_SHA256=<sha256 of voices-v1.0.bin, written by the installer>
